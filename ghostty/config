# Ghostty config — https://ghostty.org/docs/config
# Reload with cmd+shift+, ; list options with `ghostty +show-config --default --docs`

theme = Catppuccin Mocha

# Option acts as Alt so nvim (<M-y> Copilot accept) and zsh (\ey autosuggest-accept) see it
macos-option-as-alt = true

# zshrc sets block/beam cursor for vi mode itself
shell-integration-features = no-cursor

confirm-close-surface = false
