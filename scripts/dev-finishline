#!/bin/bash
SESSION="finishline"
DIR="$HOME/NER/FinishLine"

# Kill existing session if it exists
tmux has-session -t "$SESSION" 2>/dev/null && tmux kill-session -t "$SESSION"

# Create session with first window: nvim
tmux new-session -d -s "$SESSION" -c "$DIR" -n "nvim ."
tmux send-keys -t "$SESSION:nvim" "nvim ." Enter

# Create second window: dev servers + terminal
tmux new-window -t "$SESSION" -c "$DIR" -n "dev"
tmux send-keys -t "$SESSION:dev" "docker start finishline && yarn start" Enter

# Split right pane for free terminal
tmux split-window -h -t "$SESSION:dev" -c "$DIR"

# Attach to session, focused on nvim window
tmux select-window -t "$SESSION:nvim"
tmux attach -t "$SESSION"
